# LLM provider selection: mock | anthropic | openrouter | gemini  (default: mock)
LLM_PROVIDER=mock

# Optional model override (provider-specific default used otherwise)
# LLM_MODEL=claude-opus-5

# Anthropic (official SDK)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (reaches Claude/GPT/Gemini) — uses your OpenRouter credits.
# Default model anthropic/claude-haiku-5.5 (ADR-015), served by Anthropic first.
# Also passed the gates: anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5
# OPENROUTER_API_KEY=sk-or-...

# Google GenAI — uses your GCP credits
# GOOGLE_API_KEY=...

# PostgreSQL: sessions, checkpoints, turn audit log. Unset = in-memory.
# DATABASE_URL=postgresql://member:member@localhost:5432/member

# Browser origins allowed to call the API (comma-separated; default *)
# CORS_ORIGINS=http://localhost:3000

# Public-demo spend caps (unset or 0 = off; ADR-017)
# SESSION_TURN_CAP=40
# DAILY_TURN_CAP=2000
# DAILY_SESSION_CAP=500
