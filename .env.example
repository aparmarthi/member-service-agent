# LLM provider selection: mock | anthropic | openrouter | gemini  (default: mock)
LLM_PROVIDER=mock

# Optional model override (provider-specific default used otherwise)
# LLM_MODEL=claude-opus-5

# Anthropic (official SDK)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (reaches Claude/GPT/Gemini) — uses your OpenRouter credits
# OPENROUTER_API_KEY=sk-or-...

# Google GenAI — uses your GCP credits
# GOOGLE_API_KEY=...

# PostgreSQL: sessions, checkpoints, turn audit log. Unset = in-memory.
# DATABASE_URL=postgresql://pbm:pbm@localhost:5432/pbm

# Browser origins allowed to call the API (comma-separated; default *)
# CORS_ORIGINS=http://localhost:3000
